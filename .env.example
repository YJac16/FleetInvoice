# Supabase project credentials (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public app URL used for auth redirects (password reset, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: without Supabase, set to "admin" to review Pricing Engine / admin trips UI.
# Default demo session is a driver (Driver Portal).
# NEXT_PUBLIC_DEMO_ROLE=admin
