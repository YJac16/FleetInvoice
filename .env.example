# Supabase project credentials (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public app URL used for auth redirects (password reset, invite accept)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NOTIFICATIONS_PROCESS_SECRET=generate-a-long-random-string

# Optional email delivery (Resend). Without RESEND_API_KEY, invites still work via copied URL.
# Unset or blank RESEND_FROM_EMAIL falls back to GoOps <hello@goops.co.za>.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GoOps <hello@goops.co.za>

# Optional Mapbox token for dispatcher live map (Phase 7)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional. Driver place check (Google Places API New). Leave blank to use the
# Cape Town catalogue and a typed name flagged for an admin. Do not create a key
# until you want map verification. Calls run on the server; restrict the key to
# Places API (New) and, if you can, this host's IP. A browser referrer restriction
# will block server calls. Read only in server code — not sent to the browser.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Phase 9 Stripe (self-serve billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Vercel Cron (same value as NOTIFICATIONS_PROCESS_SECRET is fine)
CRON_SECRET=
