# Supabase project credentials (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public app URL used for auth redirects (password reset, invite accept)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NOTIFICATIONS_PROCESS_SECRET=generate-a-long-random-string

# Email delivery (MailerSend). Without these, invites still work via copied URL.
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=WorkOps <noreply@yourdomain.com>

# Mapbox token for dispatcher live map (Phase 7) — restrict by URL in Mapbox dashboard
NEXT_PUBLIC_MAPBOX_TOKEN=

# Phase 9 Yoco (self-serve membership checkout)
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
NEXT_PUBLIC_YOCO_PUBLIC_KEY=

# Vercel Cron (same value as NOTIFICATIONS_PROCESS_SECRET is fine)
CRON_SECRET=
